# Production env template — fill every placeholder before deploy on host `alpha`
# Canonical path: CloudPanel Nginx (host) -> Docker/Portainer app on 127.0.0.1:3000 -> Cloudflare R2
# Copy to `.env` only if deploying with docker compose directly.
# If deploying via Portainer Stack UI, use the same keys/values there instead of a file upload.

# ── Runtime / reverse proxy ──────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Portainer host bind port. Keep 3000 unless you intentionally change the reverse-proxy target.
APP_PORT=3000
APP_BASE_URL=https://download.888vn.net
APP_HOSTNAME=download.888vn.net
TRUST_PROXY=loopback
# Host path mounted into /app/src/data by deploy/portainer-stack.yml
DOWNLOAD_HUB_DATA_DIR=/opt/download-hub/data

# ── Public download flow ─────────────────────────────────────────────────────
# Real random secret, separate from admin secret. Minimum 32 chars.
DOWNLOAD_TOKEN_SECRET=replace-with-32plus-char-random-secret
DOWNLOAD_TOKEN_TTL_SECONDS=120
SESSION_COOKIE_NAME=dl888_session
SESSION_TTL_SECONDS=1200

# ── App behavior / hardening ─────────────────────────────────────────────────
# In Portainer canonical mode, the app reads metadata from /app/src/data/files.json via bind mount.
# Keep this value unchanged unless you also change the stack file.
FILES_INDEX_PATH=/app/src/data/files.json
# Dormant fallback only; canonical production storage is R2.
FILES_STORAGE_PATH=./storage/files
MAX_BODY_SIZE=20kb
ALLOWED_LOCALES=vi,en
RATE_LIMIT_WINDOW_SECONDS=300
RATE_LIMIT_MAX_ATTEMPTS=20
LOG_REQUESTS=false

# ── Cloudflare Turnstile (public page) ───────────────────────────────────────
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
TURNSTILE_ACTION=download_gate

# ── Admin login protection ───────────────────────────────────────────────────
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-strong-admin-password
# Separate from DOWNLOAD_TOKEN_SECRET. Minimum 32 chars.
ADMIN_SESSION_SECRET=replace-with-32plus-char-random-admin-session-secret
ADMIN_SESSION_TTL_SECONDS=3600
ADMIN_COOKIE_NAME=dl888_admin_sess

# ── hCaptcha (admin login page) ──────────────────────────────────────────────
HCAPTCHA_ENABLED=true
HCAPTCHA_SITE_KEY=replace-with-hcaptcha-site-key
HCAPTCHA_SECRET_KEY=replace-with-hcaptcha-secret-key
HCAPTCHA_EXPECTED_HOSTNAME=download.888vn.net

# ── Cloudflare R2 (canonical production storage) ─────────────────────────────
R2_ENABLED=true
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=download-hub-files

# ── Local-disk fallback switches (keep disabled in canonical production) ─────
USE_X_ACCEL_REDIRECT=false
X_ACCEL_INTERNAL_PREFIX=/protected-downloads

# ── Legacy compatibility ─────────────────────────────────────────────────────
# Leave blank in canonical production.
ADMIN_BEARER_TOKEN=
