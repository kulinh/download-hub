# Production env template for canonical deployment:
# CloudPanel Nginx (host) -> Docker app on 127.0.0.1:3000 -> Cloudflare R2
# Copy to .env on the server, then fill every placeholder before `docker compose up -d --build`.

# ── Runtime / reverse proxy ──────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_BASE_URL=https://download.888vn.net
APP_HOSTNAME=download.888vn.net
# CloudPanel Nginx runs on the same host and proxies into Docker via 127.0.0.1.
TRUST_PROXY=loopback

# ── Public download flow ─────────────────────────────────────────────────────
# Used to sign short-lived download tokens after Turnstile verification.
# Must be a real random secret in production (32+ chars; do not reuse passwords).
DOWNLOAD_TOKEN_SECRET=replace-with-32plus-char-random-secret
DOWNLOAD_TOKEN_TTL_SECONDS=120
SESSION_COOKIE_NAME=dl888_session
SESSION_TTL_SECONDS=1200

# ── App behavior / hardening ─────────────────────────────────────────────────
# Keep the metadata catalog writable inside the container via docker-compose volume.
FILES_INDEX_PATH=./src/data/files.json
# Canonical production uses R2, so local storage is only a dormant fallback path.
FILES_STORAGE_PATH=/app/storage/files
MAX_BODY_SIZE=20kb
ALLOWED_LOCALES=vi,en
RATE_LIMIT_WINDOW_SECONDS=300
RATE_LIMIT_MAX_ATTEMPTS=20
LOG_REQUESTS=false

# ── Cloudflare Turnstile (public page) ───────────────────────────────────────
# REQUIRED in production for the public download gate.
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
TURNSTILE_ACTION=download_gate

# ── Admin login protection ───────────────────────────────────────────────────
# Admin requires: username + password + valid hCaptcha + signed session cookie.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password
# Separate from DOWNLOAD_TOKEN_SECRET. Use another 32+ char random secret.
ADMIN_SESSION_SECRET=replace-with-32plus-char-random-admin-session-secret
ADMIN_SESSION_TTL_SECONDS=3600
ADMIN_COOKIE_NAME=dl888_admin_sess

# ── hCaptcha (admin login page) ──────────────────────────────────────────────
# REQUIRED in production for admin auth flow.
HCAPTCHA_ENABLED=true
HCAPTCHA_SITE_KEY=replace-with-hcaptcha-site-key
HCAPTCHA_SECRET_KEY=replace-with-hcaptcha-secret-key
# Must match the public hostname served by CloudPanel.
HCAPTCHA_EXPECTED_HOSTNAME=download.888vn.net

# ── Cloudflare R2 (canonical production storage) ─────────────────────────────
# REQUIRED in production. The app will refuse production boot without these.
R2_ENABLED=true
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=download-hub-files

# ── Local-disk fallback switches (keep disabled for canonical R2 production) ─
USE_X_ACCEL_REDIRECT=false
X_ACCEL_INTERNAL_PREFIX=/protected-downloads

# ── Legacy compatibility ─────────────────────────────────────────────────────
# Leave blank in production. Session auth is the intended admin path.
ADMIN_BEARER_TOKEN=
