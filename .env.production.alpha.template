# Alpha production template for download.888vn.net
# Fill real values, then save as `.env` for the PM2 deployment.

NODE_ENV=production
PORT=3000
APP_BASE_URL=https://download.888vn.net
APP_HOSTNAME=download.888vn.net
TRUST_PROXY=loopback

DOWNLOAD_TOKEN_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
DOWNLOAD_TOKEN_TTL_SECONDS=120
SESSION_COOKIE_NAME=download_hub_session
SESSION_TTL_SECONDS=1200

FILES_INDEX_PATH=./src/data/files.json
FILES_STORAGE_PATH=./storage/files
MAX_BODY_SIZE=20kb
ALLOWED_LOCALES=vi,en
RATE_LIMIT_WINDOW_SECONDS=300
RATE_LIMIT_MAX_ATTEMPTS=20
LOG_REQUESTS=false

TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=REPLACE_WITH_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=REPLACE_WITH_TURNSTILE_SECRET_KEY
TURNSTILE_ACTION=download_gate

ADMIN_USERNAME=REPLACE_WITH_ADMIN_USERNAME
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
ADMIN_SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_ADMIN_SESSION_SECRET
ADMIN_SESSION_TTL_SECONDS=3600
ADMIN_COOKIE_NAME=download_hub_admin_sess

HCAPTCHA_ENABLED=true
HCAPTCHA_SITE_KEY=REPLACE_WITH_HCAPTCHA_SITE_KEY
HCAPTCHA_SECRET_KEY=REPLACE_WITH_HCAPTCHA_SECRET_KEY
HCAPTCHA_EXPECTED_HOSTNAME=download.888vn.net

R2_ENABLED=true
R2_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_BUCKET=download-hub-files

USE_X_ACCEL_REDIRECT=false
X_ACCEL_INTERNAL_PREFIX=/protected-downloads

ADMIN_BEARER_TOKEN=
