# ── Runtime ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
APP_BASE_URL=https://download.888vn.net
APP_HOSTNAME=download.888vn.net
TRUST_PROXY=loopback

# ── Download token ─────────────────────────────────────────────────────────────
DOWNLOAD_TOKEN_SECRET=change-this-long-random-secret
SESSION_COOKIE_NAME=dl888_session
SESSION_TTL_SECONDS=1200
DOWNLOAD_TOKEN_TTL_SECONDS=120
MAX_BODY_SIZE=20kb
ALLOWED_LOCALES=vi,en

# ── File metadata index ────────────────────────────────────────────────────────
FILES_INDEX_PATH=./src/data/files.json
# Local storage path — only used in dev or when R2_ENABLED=false
FILES_STORAGE_PATH=./storage/files

# ── Cloudflare Turnstile (public download flow — REQUIRED in production) ───────
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
TURNSTILE_ACTION=download_gate

# ── hCaptcha (admin panel login — REQUIRED in production) ─────────────────────
HCAPTCHA_ENABLED=true
HCAPTCHA_SITE_KEY=your-hcaptcha-site-key
HCAPTCHA_SECRET_KEY=your-hcaptcha-secret-key
HCAPTCHA_EXPECTED_HOSTNAME=download.888vn.net

# ── Admin hard auth (REQUIRED in production) ──────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password
ADMIN_SESSION_SECRET=change-this-admin-session-secret
ADMIN_SESSION_TTL_SECONDS=3600
ADMIN_COOKIE_NAME=dl888_admin_sess

# ── Cloudflare R2 (REQUIRED in production) ────────────────────────────────────
R2_ENABLED=true
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name

# ── Nginx X-Accel-Redirect (local disk fallback, only needed if R2_ENABLED=false)
USE_X_ACCEL_REDIRECT=false
X_ACCEL_INTERNAL_PREFIX=/protected-downloads

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_SECONDS=300
RATE_LIMIT_MAX_ATTEMPTS=20
LOG_REQUESTS=false

# ── Legacy: simple bearer token for /api/admin/reload-legacy (CI/CD pipelines)
# Leave blank to disable. New deployments: use session auth instead.
ADMIN_BEARER_TOKEN=

# ── Admin Session Auth (new R2-oriented admin panel) ───────────────────────────
# Set ADMIN_PASSWORD to enable session-based admin login (/admin/login)
# Set ADMIN_SESSION_SECRET to sign session cookies (required in production)
ADMIN_PASSWORD=change-this-admin-password
ADMIN_SESSION_SECRET=change-this-session-secret-min-32-chars
ADMIN_SESSION_TTL_SECONDS=3600

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# All required for R2 file storage and presigned URL delivery
R2_ACCOUNT_ID=your-cf-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
# Optional: custom public domain for R2 (e.g. r2.download.888vn.net)
R2_PUBLIC_DOMAIN=
# Presigned URL TTL in seconds (default: 120)
R2_PRESIGNED_TTL_SECONDS=120
