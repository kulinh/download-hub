<!doctype html>
<html lang="<%= locale %>">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= t('siteTitle') %></title>
  <meta name="description" content="<%= t('siteDescription') %>" />
  <link rel="stylesheet" href="/assets/site.css" />
</head>
<body>
  <main class="container">
    <header class="hero">
      <div>
        <p class="eyebrow">download.888vn.net</p>
        <h1><%= t('siteTitle') %></h1>
        <p class="hero-desc"><%= t('siteDescription') %></p>
        <% if (provider && provider.provider === 'turnstile') { %>
          <p class="note captcha-notice"><%= t('providerTurnstile') %></p>
        <% } else if (provider && provider.provider === 'hcaptcha') { %>
          <p class="note captcha-notice"><%= t('providerHcaptcha') %></p>
        <% } else { %>
          <p class="note captcha-notice captcha-notice--warn"><%= t('captchaUnavailableHeading') %></p>
        <% } %>
      </div>
      <nav class="lang-switch" aria-label="Language selection">
        <a href="/?lang=vi" class="<%= locale === 'vi' ? 'active' : '' %>" hreflang="vi" aria-label="Tiếng Việt" aria-current="<%= locale === 'vi' ? 'true' : 'false' %>">VI</a>
        <a href="/?lang=en" class="<%= locale === 'en' ? 'active' : '' %>" hreflang="en" aria-label="English" aria-current="<%= locale === 'en' ? 'true' : 'false' %>">EN</a>
      </nav>
    </header>

    <section aria-labelledby="files-heading">
      <h2 id="files-heading"><%= t('filesHeading') %></h2>
      <% if (files.length === 0) { %>
        <div class="empty-state" role="status" aria-live="polite">
          <span class="empty-state-icon" aria-hidden="true">📭</span>
          <h3 class="empty-state-heading"><%= t('noFilesHeading') %></h3>
          <p class="empty-state-message"><%= t('noFilesMessage') %></p>
        </div>
      <% } else { %>
        <div class="grid">
          <% files.forEach((file) => { %>
            <article class="card<%= file.featured ? ' featured' : '' %>" aria-label="<%= file.title[locale] || file.title.en %>">
              <% if (file.featured) { %>
                <span class="badge-featured"><%= t('featuredBadge') %></span>
              <% } %>
              <h3><%= file.title[locale] || file.title.en %></h3>
              <p class="card-summary"><%= file.summary[locale] || file.summary.en %></p>
              <ul class="meta-list">
                <li><span class="meta-label"><%= t('platform') %></span> <span class="platform-badge platform-<%= file.platform.toLowerCase().replace(/\s+/g, '-') %>"><%= file.platform %></span></li>
                <li><span class="meta-label"><%= t('version') %></span> <%= file.version %></li>
                <li><span class="meta-label"><%= t('size') %></span> <%= file.displaySize %></li>
                <li><span class="meta-label"><%= t('updatedAt') %></span> <%= file.updatedAt ? new Date(file.updatedAt).toLocaleDateString(locale === 'vi' ? 'vi-VN' : 'en-US') : '—' %></li>
                <% if (file.r2 && file.r2.key) { %>
                  <li><span class="meta-label"><%= locale === 'vi' ? 'Lưu trữ' : 'Storage' %></span> <span class="r2-badge"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/></svg> R2</span></li>
                <% } %>
              </ul>
              <a class="button" href="/download/<%= file.slug %>?lang=<%= locale %>">
                <%= t('verifyAndDownload') %>
                <span class="btn-arrow" aria-hidden="true">→</span>
              </a>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
