<!doctype html>
<html lang="<%= locale %>" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Admin Ops</title>
  <link rel="stylesheet" href="/assets/site.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <script nonce="<%= cspNonce %>">(function(){var t=localStorage.getItem('theme')||((window.matchMedia&&window.matchMedia('(prefers-color-scheme:dark)').matches)?'dark':'light');document.documentElement.setAttribute('data-theme',t)})();</script>
</head>
<body>
  <main class="container admin-container">
    <div class="top-bar">
      <a class="back" href="/?lang=<%= locale %>">← <%= t('backHome') %></a>
      <div style="display:flex;align-items:center;gap:8px;">
        <nav class="lang-switch small" aria-label="Language selection">
          <a href="/admin?lang=vi" class="<%= locale === 'vi' ? 'active' : '' %>">VI</a>
          <a href="/admin?lang=en" class="<%= locale === 'en' ? 'active' : '' %>">EN</a>
        </nav>
        <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme" title="Toggle theme">
          <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
          <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
        <form method="POST" action="/admin/logout" style="margin:0">
          <button type="submit" class="button button-ghost button-sm">
            <%= locale === 'vi' ? 'Đăng xuất' : 'Logout' %>
          </button>
        </form>
      </div>
    </div>

    <header class="hero admin-hero">
      <div>
        <p class="eyebrow">ops / admin</p>
        <h1>Admin file ops</h1>
        <p class="hero-desc">
          <%= locale === 'vi'
            ? 'Quản lý file catalog, đồng bộ files.json, và thao tác R2 storage.'
            : 'Manage file catalog, sync files.json, and R2 storage operations.' %>
        </p>
        <% if (r2Enabled) { %>
          <p class="note" style="color:var(--color-success)">
            <%= locale === 'vi' ? '✓ R2 storage đang hoạt động' : '✓ R2 storage active' %>
          </p>
        <% } else { %>
          <p class="note" style="color:var(--color-warn)">
            <%= locale === 'vi' ? '⚠ R2 chưa bật — đang dùng local disk' : '⚠ R2 disabled — using local disk' %>
          </p>
        <% } %>
      </div>
    </header>

    <section class="card admin-card">
      <div class="admin-actions">
        <button type="button" id="load-files-btn" class="button">
          <%= locale === 'vi' ? 'Tải danh sách' : 'Load files' %>
        </button>
        <button type="button" id="sync-files-btn" class="button button-secondary">
          <%= locale === 'vi' ? 'Sync files.json từ disk' : 'Sync files.json from disk' %>
        </button>
        <button type="button" id="reload-files-btn" class="button button-secondary">
          <%= locale === 'vi' ? 'Reload app index' : 'Reload app index' %>
        </button>
        <% if (r2Enabled) { %>
          <button type="button" id="r2-upload-btn" class="button button-secondary">
            <%= locale === 'vi' ? 'Upload lên R2…' : 'Upload to R2…' %>
          </button>
        <% } %>
      </div>
      <p id="admin-status" class="result" role="status" aria-live="polite"></p>
    </section>

    <section class="admin-grid">
      <article class="card admin-card">
        <h2 class="admin-section-title"><%= locale === 'vi' ? 'Thông tin hệ thống' : 'System info' %></h2>
        <dl id="admin-meta" class="kv-list"></dl>
      </article>

      <article class="card admin-card">
        <h2 class="admin-section-title"><%= locale === 'vi' ? 'File có trên disk nhưng chưa có trong files.json' : 'Disk files missing from files.json' %></h2>
        <div id="admin-extra-files" class="table-wrap"></div>
      </article>
    </section>

    <section class="card admin-card">
      <h2 class="admin-section-title"><%= locale === 'vi' ? 'Catalog files.json + trạng thái trên disk' : 'files.json catalog + on-disk status' %></h2>
      <div id="admin-files-table" class="table-wrap"></div>
    </section>
  </main>

  <script
    src="/assets/admin.js"
    nonce="<%= cspNonce %>"
    data-locale="<%= locale %>"
    data-r2-enabled="<%= r2Enabled %>"
    data-msg-loading="<%= locale === 'vi' ? 'Đang tải dữ liệu…' : 'Loading data…' %>"
    data-msg-load-success="<%= locale === 'vi' ? 'Tải dữ liệu admin thành công.' : 'Admin data loaded.' %>"
    data-msg-syncing="<%= locale === 'vi' ? 'Đang quét disk và cập nhật files.json…' : 'Scanning disk and updating files.json…' %>"
    data-msg-sync-success="<%= locale === 'vi' ? 'Đồng bộ files.json xong.' : 'files.json sync completed.' %>"
    data-msg-reloading="<%= locale === 'vi' ? 'Đang reload index…' : 'Reloading index…' %>"
    data-msg-reload-success="<%= locale === 'vi' ? 'Reload thành công.' : 'Reload completed.' %>"
    data-msg-no-extra="<%= locale === 'vi' ? 'Không có file lẻ trên disk.' : 'No extra files found on disk.' %>"
    data-msg-no-files="<%= locale === 'vi' ? 'Chưa có entry nào trong files.json.' : 'No entries in files.json yet.' %>"
    data-label-storage-path="<%= locale === 'vi' ? 'Storage path' : 'Storage path' %>"
    data-label-index-path="<%= locale === 'vi' ? 'Index path' : 'Index path' %>"
    data-label-total-files="<%= locale === 'vi' ? 'Tổng entry' : 'Total entries' %>"
    data-label-extra-files="<%= locale === 'vi' ? 'File lẻ trên disk' : 'Extra disk files' %>"
    data-label-created="<%= locale === 'vi' ? 'Tạo mới' : 'Created' %>"
    data-label-updated="<%= locale === 'vi' ? 'Cập nhật' : 'Updated' %>"
    data-label-unchanged="<%= locale === 'vi' ? 'Không đổi' : 'Unchanged' %>"
    data-col-slug="slug"
    data-col-relative-path="relativePath"
    data-col-published="<%= locale === 'vi' ? 'published' : 'published' %>"
    data-col-catalog-size="<%= locale === 'vi' ? 'sizeBytes (json)' : 'sizeBytes (json)' %>"
    data-col-disk-size="<%= locale === 'vi' ? 'sizeBytes (disk)' : 'sizeBytes (disk)' %>"
    data-col-catalog-sha="<%= locale === 'vi' ? 'SHA-256 (json)' : 'SHA-256 (json)' %>"
    data-col-disk-sha="<%= locale === 'vi' ? 'SHA-256 (disk)' : 'SHA-256 (disk)' %>"
    data-col-status="<%= locale === 'vi' ? 'Trạng thái' : 'Status' %>"
    data-status-match="<%= locale === 'vi' ? 'Khớp' : 'Match' %>"
    data-status-mismatch="<%= locale === 'vi' ? 'Lệch metadata' : 'Metadata mismatch' %>"
    data-status-missing="<%= locale === 'vi' ? 'Thiếu file trên disk' : 'Missing on disk' %>"
  ></script>
  <script src="/assets/theme.js"></script>
</body>
</html>
